# =============================================================================
# Predictive Defect Analysis Engine — Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# Required variables are marked with [REQUIRED].
# Optional variables have sensible defaults shown.
# =============================================================================

# -----------------------------------------------------------------------------
# JIRA CONNECTION [REQUIRED for live mode]
# -----------------------------------------------------------------------------
# Your Jira instance base URL (Cloud or Server)
# Example: https://yourcompany.atlassian.net
JIRA_URL=

# Jira account email (used for Basic Auth)
JIRA_EMAIL=

# Jira API token — generate at: https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_API_TOKEN=

# Jira project key to analyze (e.g., "AP", "MYPROJ")
JIRA_PROJECT_KEY=

# -----------------------------------------------------------------------------
# LLM PROVIDER [REQUIRED for analysis — BYOK]
# -----------------------------------------------------------------------------
# Which LLM provider to use: "groq" or "openai"
LLM_PROVIDER=groq

# Groq API key — get yours at: https://console.groq.com/keys
GROQ_API_KEY=

# OpenAI API key — get yours at: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# LLM model override (leave empty to use defaults)
# Default for Groq: llama-3.3-70b-versatile
# Default for OpenAI: gpt-4o-mini
LLM_MODEL=

# -----------------------------------------------------------------------------
# API SECURITY
# -----------------------------------------------------------------------------
# API key for authenticating requests to the backend
# Auto-generated on first run if left empty
API_KEY=

# -----------------------------------------------------------------------------
# RATE LIMITING & COST CONTROL
# -----------------------------------------------------------------------------
# Maximum LLM API calls per day (resets at midnight)
MAX_DAILY_REQUESTS=50

# Seconds to wait between consecutive LLM requests (Groq free-tier friendly)
GROQ_SLEEP=2

# Maximum retry attempts for transient errors (hard cap, no infinite loops)
MAX_RETRIES=2

# -----------------------------------------------------------------------------
# MOCK DATA MODE
# -----------------------------------------------------------------------------
# Set to True to bypass Jira and use sample_bugs.json for demo/evaluation
# Perfect for GitHub visitors who want to try the tool without Jira credentials
USE_MOCK_DATA=False

# -----------------------------------------------------------------------------
# DATA ANONYMIZATION
# -----------------------------------------------------------------------------
# When True, PII (emails, IPs, URLs, phone numbers) is masked before sending
# data to the LLM. Recommended for production use with real customer data.
ANONYMIZE_DATA=True

# -----------------------------------------------------------------------------
# SERVER CONFIGURATION
# -----------------------------------------------------------------------------
# FastAPI backend
API_HOST=0.0.0.0
API_PORT=8000

# Streamlit frontend
STREAMLIT_PORT=8501

# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
