# Environment & secrets
.env
# .env.tmp is the sibling temp file config.set_env_value writes before
# os.replace swaps it in. A crash between the two leaves it on disk holding a
# full copy of the credentials. .dockerignore already excluded `.env.*`; git
# did not, so the leftover was visible to `git add -A`. .env.example is
# committed and has to survive the wildcard.
.env.*
!.env.example

# Python
.venv/
# Throwaway env used to prove the core install works without the webhook extra
.venv-core/
__pycache__/
*.pyc
*.pyo

# Packaging artifacts
src/*.egg-info/
build/
dist/

# Runtime data (user-specific, regenerated at runtime)
data/bugs.json
data/chroma_db/
data/anon_map.json
data/analysis_results.json
data/defect_density.json
data/webhook_results.json

# Keep sample data for demo/mock mode
!data/sample_bugs.json

# Faz 2 refactor baseline — local-only scoring snapshots, never committed
baseline/

# Scratch snapshots from tests/tools/make_baseline.py (root-level only).
# The committed fixtures live in tests/data/ and are NOT matched by this.
/scores-*.json

# IDE
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db

# Docker
*.log

.claude/
